generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  decks          Deck[]
  generationJobs GenerationJob[]
  costLedger     CostLedger[]
  contentCache   ContentCache[]
}

model Deck {
  id          String    @id @default(cuid())
  userId      String
  title       String
  sourceUrl   String
  shareId     String?   @unique
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  exaRaw      Json?
  quality     String    @default("medium") // low, medium, high
  contentHash String?   // Hash of deck content for cache invalidation on edits
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  slides         Slide[]
  generationJobs GenerationJob[]
  costLedger     CostLedger[]
}

model Slide {
  id                String   @id @default(cuid())
  deckId            String
  position          Int
  mainIdea          String
  summary           String   @db.Text
  supportingIdeas   Json     // Array of {idea: string, details: string}
  infographicPrompt String   @db.Text
  imageUrl          String?
  imageStatus       String   @default("pending") // pending, generating, completed, failed
  imageVersions     Json     @default("[]") // [{url, prompt, createdAt}]
  stylePreset       String   @default("whiteboard")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deck       Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  costLedger CostLedger[]

  @@unique([deckId, position])
}

model GenerationJob {
  id          String    @id @default(cuid())
  userId      String
  deckId      String?
  sourceUrl   String
  status      String    @default("queued") // queued, extracting, analyzing, generating_images, complete, failed
  progress    Json?     // {step, current, total, details}
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  deck Deck? @relation(fields: [deckId], references: [id])
}

model ContentCache {
  id          String   @id @default(cuid())
  userId      String
  urlHash     String   @unique
  url         String
  deckId      String
  contentHash String?  // Hash of deck content for invalidation on edits
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, urlHash])
}

model CostLedger {
  id            String   @id @default(cuid())
  userId        String
  deckId        String?
  slideId       String?
  service       String   // exa, gpt-5.5, gpt-image-2
  operation     String   // extract, insights, image_gen, regenerate
  estimatedCost Decimal  @db.Decimal(10, 6)
  createdAt     DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  deck  Deck?  @relation(fields: [deckId], references: [id])
  slide Slide? @relation(fields: [slideId], references: [id])
}
